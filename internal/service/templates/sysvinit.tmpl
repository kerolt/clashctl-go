### BEGIN INIT INFO
# Provides: __KERNEL_NAME__
# Required-Start: $network $local_fs $remote_fs
# Required-Stop: $network $local_fs $remote_fs
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: __KERNEL_DESC__
# Description: __KERNEL_DESC__
### END INIT INFO

pidfile="__PID_PATH__"
logfile="__LOG_PATH__"
cmd="__KERNEL_CMD__"

case "$1" in
start)
    $0 status >&/dev/null && exit 0
    $cmd >&$logfile &
    echo $! >$pidfile
    ;;
stop)
    pid=$(cat $pidfile 2>/dev/null)
    [ -n "$pid" ] && kill -9 "$pid"
    rm -f $pidfile
    ;;
restart | reload)
    $0 stop
    sleep 0.5
    $0 start
    ;;
status)
    pid=$(cat $pidfile 2>/dev/null)
    isStart=$(ps ax | awk '{ print $1 }' | grep -e "^${pid}$")
    [ -n "$isStart" ] && {
        echo "__KERNEL_NAME__ is running with PID: $pid"
        exit 0
    }
    echo "__KERNEL_NAME__ is not running."
    exit 1
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    ;;
esac
